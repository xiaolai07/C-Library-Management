	system("cls");
	bookmenu();
}

void delbook() {
	struct book* head = NULL;
	//修复：指针全部初始化NULL，解决C4703
	struct book* p = NULL, * p1 = NULL, * p2 = NULL;
	int tmany = 0, n = 0, j, k;
	float tprice = 0;
	char tnam[20] = { '\0' }, taut[20] = { '\0' }, tcat[20] = { '\0' }, tpub[20] = { '\0' }, tnum[20] = { '\0' };
	char jjnam[20] = { '\0' };
	FILE* fp;
	if ((fp = fopen("library.txt", "r")) == NULL)
	{
		system("cls");
		printf("\n记录文件不存在!按任意键返回");
		(void)_getch();
		bookmenu();
	}
	else
	{
		system("cls");
		printf("\n请输入你要删除的书名:");
		scanf("%s", jjnam);
		fp = fopen("library.txt", "r");
		j = tjts();
		for (k = 0; k < j; k++)
		{
			fscanf(fp, "%s%s%s%s%s%d%f", tnum, tnam, taut, tpub, tcat, &tmany, &tprice);
			if (strcmp(jjnam, tnam))
			{
				n++;
				if (n == 1)
				{
					p1 = p2 = (struct book*)malloc(LEN);
					head = p1;
				}
				else
				{
					p2->next = p1;
					p2 = p1;
					p1 = (struct book*)malloc(LEN);
				}
				strcpy(p1->num, tnum);
				strcpy(p1->name, tnam);
				strcpy(p1->aut, taut);
				strcpy(p1->pub, tpub);
				strcpy(p1->cat, tcat);
				p1->many = tmany;
				p1->prince = tprice;
			}
		}
		if (n == 0)
		{
			head = NULL;
		}
		else
		{
			p2->next = p1;
			p1->next = NULL;
			fclose(fp);
		}
	}
	fp = fopen("library.txt", "w");
	fclose(fp);
	fp = fopen("library.txt", "a");
	p = head;
	for (; p != NULL;)
	{
		fprintf(fp, "%-8s%-9s%-14s%-16s%-18s%-7d%-8.2f\n", p->num, p->name, p->aut, p->pub, p->cat, p->many, p->prince);
		p = p->next;
	}
	fclose(fp);
	printf("\n删除成功 \n按任意键返回上一层\n");
	(void)_getch();
	system("cls");
	bookmenu();
}

