	{
		fp = fopen("library.txt", "w");
		fclose(fp);
	}
	fp = fopen("library.txt", "a");
	printf("\n请按以下格式输入图书信息:\n书号 书名 作者 出版社 类别 进库量 单价");
	for (; i != 27;)
	{
		printf("请输入:\n");
		scanf("%s%s%s%s%s%d%f", num, name, aut, pub, cat, &many, &prince);
